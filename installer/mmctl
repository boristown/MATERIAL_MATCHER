#!/usr/bin/env bash
# 物料集团码智能匹配平台 · 维护工具（安装后位于 /opt/material_matcher/bin/mmctl，
# 并链接为 /usr/local/bin/mmctl）。全部操作离线，不访问公网。
set -uo pipefail

OPT="/opt/material_matcher"
ETC="/etc/material_matcher"
VAR="/var/lib/material_matcher"
LOG="/var/log/material_matcher"
SERVICE="material_matcher.service"
RUNTIME_PY="$OPT/current/runtime/bin/python3"
BOOTSTRAP_PY="$OPT/bootstrap/python/bin/python3"
APP_USER="material_matcher"

die() { echo "操作失败：$*" >&2; exit 1; }
need_root() { [[ $EUID -eq 0 ]] || die "请使用 root 或 sudo 运行维护工具。"; }

mm_py() {
  if [[ -x "$RUNTIME_PY" ]]; then echo "$RUNTIME_PY"
  elif [[ -x "$BOOTSTRAP_PY" ]]; then echo "$BOOTSTRAP_PY"
  elif command -v python3 >/dev/null 2>&1; then command -v python3
  else echo ""; fi
}

source_env() {
  local py="$1"
  [[ -f "$ETC/server.env" ]] || die "缺少 $ETC/server.env，系统似乎尚未安装。"
  MM_PORT="$(grep -m1 '^MATERIAL_MATCHER_PORT=' "$ETC/server.env" | cut -d= -f2)"
  DATA_DIR="$(grep -m1 '^MATERIAL_MATCHER_DATA_DIR=' "$ETC/storage.env" 2>/dev/null | cut -d= -f2 | tr -d '"')"
  [[ -n "$DATA_DIR" ]] || DATA_DIR="$VAR"
}

cmd_version() {
  local py; py="$(mm_py)"
  [[ -d "$OPT/current" ]] || die "系统尚未安装。"
  readlink -f "$OPT/current"
  if [[ -n "$py" && -f "$OPT/current/release-manifest.json" ]]; then
    "$py" - "$OPT/current/release-manifest.json" <<'PY'
import json, sys
m = json.load(open(sys.argv[1], encoding="utf-8"))
print("版本：", m.get("release_version"))
print("commit：", m.get("git_commit", "unknown"))
print("架构：", m.get("target_arch"), " Python：", m.get("python_version"))
PY
  fi
}

cmd_status() {
  local py; py="$(mm_py)"; source_env "$py"
  echo "服务状态：$(systemctl is-active "$SERVICE" 2>/dev/null || true)（开机自启：$(systemctl is-enabled "$SERVICE" 2>/dev/null || true)）"
  echo "当前版本目录：$(readlink -f "$OPT/current" 2>/dev/null || echo 未安装)"
  [[ -n "$py" ]] && curl -sS --max-time 3 "http://127.0.0.1:${MM_PORT}/api/health" 2>/dev/null \
    || "$py" -c "import urllib.request;print(urllib.request.urlopen('http://127.0.0.1:${MM_PORT}/api/health',timeout=3).read().decode())" 2>/dev/null \
    || echo "health 请求失败：服务可能未启动"
}

cmd_logs() {
  local n="${1:-80}"
  journalctl -u "$SERVICE" -n "$n" --no-pager 2>/dev/null || tail -n "$n" "$LOG"/*.log 2>/dev/null || die "没有可显示的日志。"
}

service_action() {
  need_root
  systemctl "$1" "$SERVICE" && echo "已执行：$1 $SERVICE"
}

cmd_doctor() {
  local py; py="$(mm_py)"
  [[ -n "$py" ]] || die "没有可用的运行环境。"
  runuser -u "$APP_USER" -- env \
    MATERIAL_MATCHER_DATA_DIR="$DATA_DIR" MATERIAL_MATCHER_CONFIG_DIR="$ETC" \
    MATERIAL_MATCHER_LOG_DIR="$LOG" MATERIAL_MATCHER_MODEL_ROOT="$VAR/models/current" \
    MATERIAL_MATCHER_WEB_DIST_DIR="$OPT/current/web/dist" \
    "$OPT/current/runtime/bin/material-matcher" doctor \
    --require-frontend --require-embedding --require-release-manifest
}

cmd_export() {
  need_root
  local out="${1:-/var/tmp}" py; py="$(mm_py)"; source_env "$py"
  local dir stage ts; ts="$(date +%Y%m%d-%H%M%S)"; dir="mm-diagnostics-$ts"; stage="/var/tmp/$dir"
  mkdir -p "$stage"
  { echo "时间：$(date '+%F %T')"
    echo "版本目录：$(readlink -f "$OPT/current" 2>/dev/null)"
    [[ -f "$OPT/current/release-manifest.json" ]] && cat "$OPT/current/release-manifest.json"
    systemctl status "$SERVICE" --no-pager 2>/dev/null | head -40
    journalctl -u "$SERVICE" -n 400 --no-pager 2>/dev/null
    echo "端口：$MM_PORT  数据目录：$DATA_DIR"
    [[ -n "$py" ]] && "$py" -c "import urllib.request;print(urllib.request.urlopen('http://127.0.0.1:${MM_PORT}/api/health/ready',timeout=5).read().decode())" 2>/dev/null
    ls -l "$DATA_DIR/meta" 2>/dev/null
    df -h "$OPT" "$DATA_DIR" 2>/dev/null
  } >"$stage/diagnostics.txt" 2>&1
  # 安全边界：不包含密码文件、会话、上传正文与完整数据库。
  cp "$ETC/storage.env" "$stage/" 2>/dev/null || true
  [[ -d "$LOG/install-reports" ]] && cp "$LOG/install-reports"/*.txt "$stage/" 2>/dev/null || true
  chmod -R go-rwx "$stage"
  tar -C /var/tmp -czf "$out/$dir.tar.gz" "$dir"
  rm -rf "$stage"
  echo "诊断包已导出：$out/$dir.tar.gz（不含密码/会话/客户文件）"
}

cmd_backup() {
  need_root
  local out="${1:-/var/backups/material_matcher}" py; py="$(mm_py)"; source_env "$py"
  [[ -n "$py" ]] || die "没有可用的运行环境。"
  mkdir -p "$out"
  local ts dir stage; ts="$(date +%Y%m%d-%H%M%S)"; dir="mm-backup-$ts"; stage="$(mktemp -d)"
  mkdir -p "$stage/$dir"
  "$py" - "$DATA_DIR/meta/material_matcher.db" "$stage/$dir/material_matcher.db" <<'PY'
import sqlite3, sys
src, dst = sys.argv[1], sys.argv[2]
try:
    to = sqlite3.connect(dst)
    frm = sqlite3.connect(f"file:{src}?mode=ro", uri=True)
    frm.backup(to); to.close(); frm.close()
except sqlite3.OperationalError as exc:
    if "no such table" not in str(exc): raise
    sqlite3.connect(dst).close()
PY
  cp -a "$ETC" "$stage/$dir/etc-material_matcher" 2>/dev/null || true
  chmod 600 "$stage/$dir/etc-material_matcher/secret/admin_password.env" 2>/dev/null || true
  ( cd "$stage" && tar -czf "$out/$dir.tar.gz" "$dir" )
  rm -rf "$stage"
  chmod 600 "$out/$dir.tar.gz"
  echo "备份完成：$out/$dir.tar.gz"
}

cmd_verify_backup() {
  local file="$1" py; py="$(mm_py)"
  [[ -n "$py" ]] || die "没有可用的运行环境。"
  [[ -f "$file" ]] || die "备份文件不存在：$file"
  local stage; stage="$(mktemp -d)"
  tar -xzf "$file" -C "$stage" || { rm -rf "$stage"; die "备份包解压失败：文件可能损坏"; }
  local db; db="$(find "$stage" -name material_matcher.db | head -1)"
  [[ -n "$db" ]] || { rm -rf "$stage"; die "备份包中未找到 metadata 数据库"; }
  "$py" - "$db" <<'PY'
import sqlite3, sys
con = sqlite3.connect(sys.argv[1])
ok = con.execute("PRAGMA integrity_check").fetchone()[0]
tables = [r[0] for r in con.execute("SELECT name FROM sqlite_master WHERE type='table'")]
assert ok == "ok", f"数据库完整性检查失败：{ok}"
print(f"备份验证通过：integrity=ok，表数量={len(tables)}")
PY
  local rc=$?
  rm -rf "$stage"
  return $rc
}

cmd_restore() {
  need_root
  local file="$1" py; py="$(mm_py)"
  [[ -n "$py" ]] || die "没有可用的运行环境。"
  [[ -f "$file" ]] || die "备份文件不存在：$file"
  cmd_verify_backup "$file" || die "备份验证未通过，拒绝恢复。"
  local stage; stage="$(mktemp -d)"
  tar -xzf "$file" -C "$stage"
  local db src_db; db="$(find "$stage" -name material_matcher.db | head -1)"
  source_env "$py"
  local ts; ts="$(date +%Y%m%d-%H%M%S)"
  [[ -f "$DATA_DIR/meta/material_matcher.db" ]] && cp -a "$DATA_DIR/meta/material_matcher.db" "$DATA_DIR/meta/material_matcher.db.pre-restore-$ts"
  systemctl stop "$SERVICE" 2>/dev/null || true
  cp -f "$db" "$DATA_DIR/meta/material_matcher.db"
  local etccfg; etccfg="$(find "$stage" -maxdepth 2 -type d -name 'etc-material_matcher' | head -1)"
  if [[ -n "$etccfg" ]]; then
    cp -a "$etccfg/." "$ETC/" 2>/dev/null || true
    chown root:root "$ETC/secret" 2>/dev/null || true; chmod 700 "$ETC/secret" 2>/dev/null || true
    chmod 600 "$ETC/secret/admin_password.env" 2>/dev/null || true
  fi
  rm -rf "$stage"
  chown "$APP_USER:$APP_USER" "$DATA_DIR/meta/material_matcher.db"
  systemctl start "$SERVICE" || die "恢复后服务启动失败；原数据库副本保存在 $DATA_DIR/meta/material_matcher.db.pre-restore-$ts"
  for _ in $(seq 1 60); do
    "$py" -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:$(grep -m1 '^MATERIAL_MATCHER_PORT=' "$ETC/server.env" | cut -d= -f2)/api/health/ready',timeout=2).read()" 2>/dev/null && break
    sleep 1
  done
  echo "恢复完成，服务已启动。恢复前数据库已另存为 material_matcher.db.pre-restore-$ts"
}

cmd_rebuild_frontend() {
  need_root
  local tools="$OPT/tools/node-offline"
  [[ -d "$tools" ]] || die "本介质未包含离线前端重建资源（tools/node-offline）。"
  local src="$OPT/current/source/web"
  [[ -d "$src" ]] || die "未找到 Vue 源码目录 $src。"
  echo "正在离线重建前端（不访问公网）……"
  export PATH="$tools/node/bin:$PATH"
  mkdir -p "$src/node_modules"
  [[ -d "$src/node_modules/.installed" ]] || tar -xf "$tools/node_modules.tar" -C "$src/"
  ( cd "$src" && npm run build --offline --no-audit --no-fund ) || die "前端构建失败，请查看输出。"
  echo "重建完成：$src/dist。运行 restart 命令生效。"
}

usage() {
  cat <<'EOF'
mmctl <命令> —— 物料集团码智能匹配平台维护工具

  status            查看服务状态与版本
  start | stop | restart
  logs [行数]        查看最近日志
  doctor            部署健康诊断
  version           查看版本与 commit
  backup [目录]      备份（数据库一致性备份 + 配置），默认 /var/backups/material_matcher
  verify <备份文件>  验证备份可用性
  restore <文件>    从备份恢复（恢复前自动留存当前库）
  export [目录]      导出诊断包（不含密码/会话/客户文件）
  rebuild-frontend  离线重建 Vue 前端（高级，需介质提供 node-offline 资源）
EOF
}

case "${1:-}" in
  status) cmd_status ;;
  start) service_action start ;;
  stop) service_action stop ;;
  restart) service_action restart ;;
  logs) cmd_logs "${2:-80}" ;;
  doctor) need_root; source_env "$(mm_py)"; cmd_doctor ;;
  version) cmd_version ;;
  backup) cmd_backup "${2:-}" ;;
  verify) cmd_verify_backup "${2:-}" ;;
  restore) [[ -n "${2:-}" ]] || { usage; exit 1; }; cmd_restore "$2" ;;
  export) cmd_export "${2:-}" ;;
  rebuild-frontend) cmd_rebuild_frontend ;;
  *) usage; exit 1 ;;
esac
