#!/usr/bin/env bash
# 输出当前版本。兼容 1.3.14-1.3.16（无 VERSION 文件，用 __init__ 或 releases 目录名兜底）
set -uo pipefail
MODE=auto; CTR=material_matcher-app
case "${1:-}" in --docker) MODE=docker; CTR="${2:-material_matcher-app}";; --native) MODE=native;; "") ;; *) CTR="$1";; esac
if [ "$MODE" = auto ]; then
  if command -v docker >/dev/null 2>&1 && docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "$CTR"; then MODE=docker; else MODE=native; fi
fi
read_ver() { # $1 = exec-prefix style: path
  local V
  V=$(cat /opt/material_matcher/current/app/material_matcher/VERSION 2>/dev/null) || V=""
  [ -z "$V" ] && V=$(sed -n 's/__version__ = *"\(.*\)"/\1/p' /opt/material_matcher/current/app/material_matcher/__init__.py 2>/dev/null | head -1)
  [ -z "$V" ] && V=$(basename "$(readlink /opt/material_matcher/current 2>/dev/null)" 2>/dev/null | sed 's/^release//;s/^v//')
  [ -z "$V" ] && V=UNKNOWN
  echo "$V"
}
if [ "$MODE" = docker ]; then
  docker exec "$CTR" sh -c "$(declare -f read_ver >/dev/null 2>&1; true)"; \
  docker exec "$CTR" sh -c 'V=$(cat /opt/material_matcher/current/app/material_matcher/VERSION 2>/dev/null); [ -z "$V" ] && V=$(sed -n "s/__version__ = *\"\(.*\)\"/\1/p" /opt/material_matcher/current/app/material_matcher/__init__.py 2>/dev/null | head -1); [ -z "$V" ] && V=$(basename "$(readlink /opt/material_matcher/current 2>/dev/null)" | sed "s/^release//;s/^v//"); echo "${V:-UNKNOWN}"'
else
  read_ver
fi
