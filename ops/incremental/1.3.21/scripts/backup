#!/usr/bin/env bash
set -uo pipefail
MODE="${1:-auto}"; CTR="${2:-material_matcher-app}"
STAMP=$(date +%Y%m%d-%H%M%S)
BK="/var/lib/material_matcher/backups/incremental-1.3.21-$STAMP"
mkdir -p "$BK"
if [ "$MODE" = "docker" ]; then
  docker exec "$CTR" sh -c "mkdir -p /var/lib/material_matcher/backups/incremental-1.3.21-$STAMP && cp -a /opt/material_matcher/current/app/material_matcher /var/lib/material_matcher/backups/incremental-1.3.21-$STAMP/material_matcher && cp -a /opt/material_matcher/current/web/dist /var/lib/material_matcher/backups/incremental-1.3.21-$STAMP/dist && /opt/material_matcher/current/runtime/bin/python3 -c 'import sqlite3;s=sqlite3.connect(\"/var/lib/material_matcher/meta/material_matcher.db\");d=sqlite3.connect(\"/var/lib/material_matcher/backups/incremental-1.3.21-$STAMP/db.sqlite\");s.backup(d);d.close()'"
  docker exec "$CTR" sh -c "find /var/lib/material_matcher/uploads -type f | head -20000 > /var/lib/material_matcher/backups/incremental-1.3.21-$STAMP/uploads.list; du -sb /var/lib/material_matcher/uploads >> /var/lib/material_matcher/backups/incremental-1.3.21-$STAMP/uploads.list"
else
  cp -a /opt/material_matcher/current/app/material_matcher "$BK/material_matcher"
  cp -a /opt/material_matcher/current/web/dist "$BK/dist"
  /opt/material_matcher/current/runtime/bin/python3 -c "import sqlite3;s=sqlite3.connect('/var/lib/material_matcher/meta/material_matcher.db');d=sqlite3.connect('$BK/db.sqlite');s.backup(d);d.close()"
  find /var/lib/material_matcher/uploads -type f | head -20000 > "$BK/uploads.list"
fi
cp -a /etc/material_matcher "$BK/etc" 2>/dev/null || true
echo "BACKUP=$BK"; ls "$BK"
