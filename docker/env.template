# 复制为 docker/.env 后使用。不要把真实密码提交到 Git。
MM_PORT=18080
MM_ADMIN_PASSWORD=请改成至少10位且同时包含字母和数字的密码

# 持久化目录：均为宿主机路径。docker compose down 不会删除这些目录。
MM_DATA_DIR=./data
MM_CONFIG_DIR=./config
MM_LOG_DIR=./logs

# 镜像名称可按现场规范修改。
MM_IMAGE_NAME=material-matcher-source
MM_IMAGE_TAG=local

# 离线现场应由 OpenCode 预先导入对应基础镜像，再保持这里的名称一致。
MM_NODE_BASE_IMAGE=node:20-bookworm-slim
MM_PYTHON_BASE_IMAGE=python:3.11-slim

# 可选构建信息，用于“系统设置 · 关于”。
MM_GIT_COMMIT=
MM_BUILD_TIME=
